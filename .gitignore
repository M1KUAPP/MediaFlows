# Terraform

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json
# Exception: the env-level tfvars for the root stack no longer contain any
# secrets (those moved to SSM) — track them so `make plan`/`make apply` can pass -var-file.
# Bootstrap's tfvars stays gitignored because it DOES carry seed secrets.
!infrastructure/environments/*.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Terraform error-state dumps
errored.tfstate

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Generated by `make bootstrap`; the state bucket name embeds the AWS account id
backend.hcl

# Custom
infrastructure/modules/serverless/placeholder.zip

# Tools
.rtk/
